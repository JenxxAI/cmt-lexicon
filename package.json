{
  "name": "cmt-lexicon",
  "version": "0.1.0",
  "private": true,
  "description": "UI Lexicon: a free, open-source glossary of UI components with token-lean prompts for AI coding tools.",
  "license": "MIT",
  "scripts": {
    "dev": "npm run exports && next dev",
    "build": "npm run validate && npm run exports && next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-search.ts",
    "validate": "tsx scripts/validate-content.ts",
    "exports": "tsx scripts/build-exports.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
