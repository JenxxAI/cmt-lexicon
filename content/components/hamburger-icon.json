  "prompts": {
    "short": "Add a hamburger button that opens the mobile menu.",
    "detailed": "Add a 44px hamburger icon button (three lines) to the navbar on screens below 768px. Give it an aria-label, aria-expanded, and aria-controls pointing at the menu, and animate it to an X when open."
  },
  "snippets": {
    "html": [
      "<button aria-label=\"Open menu\" aria-expanded=\"false\" aria-controls=\"menu\">",
      "  <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\"",
      "       stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\">",
      "    <path d=\"M4 6h16M4 12h16M4 18h16\" />",
      "  </svg>",
      "</button>"
    ],
    "reactTailwind": [
      "import { Menu } from \"lucide-react\";",
      "",
      "<button",
      "  aria-label=\"Open menu\"",
      "  aria-expanded={open}",
      "  aria-controls=\"menu\"",
      "  className=\"grid h-11 w-11 place-items-center\"",
      ">",
      "  <Menu aria-hidden=\"true\" />",
      "</button>"
    ],
    "vue": [
      "<script setup>",
      "import { useId, ref } from \"vue\";",
      "const open = ref(false);",
      "const uid = useId();",
      "</script>",
      "",
      "<template>",
      "  <button type=\"button\" aria-label=\"Toggle navigation\" :aria-expanded=\"open\" :aria-controls=\"uid + '-menu'\" @click=\"open = !open\">",
      "    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M4 6h16M4 12h16M4 18h16\" /></svg>",
      "  </button>",
      "  <nav :id=\"uid + '-menu'\" v-show=\"open\" aria-label=\"Main\"><a href=\"/guides/\">Guides</a></nav>",
      "</template>",
      "",
      "<style scoped>",
      "button, input, select, summary { min-height: 44px; }",
      "button { min-width: 44px; }",
      "button, a { touch-action: manipulation; }",
      "a { display: inline-flex; align-items: center; min-height: 44px; }",
      ":focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }",
      "input, select { max-width: 100%; box-sizing: border-box; }",
      "button { min-width: 44px; }",
      "</style>"
    ]
  },
