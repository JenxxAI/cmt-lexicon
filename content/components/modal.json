  "prompts": {
    "short": "Add a centered modal with title, body, Cancel and Confirm buttons. Trap focus.",
    "detailed": "Add a centered modal (max-width 480px) with a title, body text, and Cancel/Confirm buttons over a dimmed backdrop. Trap focus, close on Esc, lock page scroll while open, and use the dialog role with aria-modal and aria-labelledby."
  },
  "snippets": {
    "html": [
      "<dialog id=\"confirm\">",
      "  <h2>Delete project?</h2>",
      "  <p>This can't be undone.</p>",
      "  <form method=\"dialog\">",
      "    <button>Cancel</button>",
      "    <button value=\"confirm\">Delete</button>",
      "  </form>",
      "</dialog>",
      "",
      "<button onclick=\"document.getElementById('confirm').showModal()\">Delete</button>"
    ],
    "reactTailwind": [
      "export function Modal({ open, onClose, title, children }: {",
      "  open: boolean;",
      "  onClose: () => void;",
      "  title: string;",
      "  children: React.ReactNode;",
      "}) {",
      "  if (!open) return null;",
      "  return (",
      "    <div className=\"fixed inset-0 grid place-items-center bg-black/50\" onClick={onClose}>",
      "      <div",
      "        role=\"dialog\"",
      "        aria-modal=\"true\"",
      "        aria-label={title}",
      "        className=\"w-full max-w-md rounded-xl bg-white p-6\"",
      "        onClick={(e) => e.stopPropagation()}",
      "      >",
      "        <h2 className=\"text-lg font-semibold\">{title}</h2>",
      "        {children}",
      "      </div>",
      "    </div>",
      "  );",
      "}"
    ],
    "vue": [
      "<script setup>",
      "import { useId, ref } from \"vue\";",
      "const dialog = ref(null);",
      "const trigger = ref(null);",
      "const uid = useId();",
      "</script>",
      "",
      "<template>",
      "  <button ref=\"trigger\" type=\"button\" @click=\"dialog.showModal()\">Open modal</button>",
      "  <dialog ref=\"dialog\" :aria-labelledby=\"uid + '-title'\" @close=\"trigger?.focus()\">",
      "    <h2 :id=\"uid + '-title'\">Project details</h2>",
      "    <p>Review the available options.</p>",
      "    <a href=\"/guides/\">Browse guides</a>",
      "    <form method=\"dialog\"><button autofocus>Close</button></form>",
      "  </dialog>",
      "</template>",
      "",
      "<style scoped>",
      "button, input, select, summary { min-height: 44px; }",
      "button { min-width: 44px; }",
      "button, a { touch-action: manipulation; }",
      "a { display: inline-flex; align-items: center; min-height: 44px; }",
      ":focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }",
      "input, select { max-width: 100%; box-sizing: border-box; }",
      "dialog { box-sizing: border-box; max-width: min(100%, 28rem); overflow: auto; background: Canvas; color: CanvasText; }",
      "dialog::backdrop { background: rgb(0 0 0 / 50%); }",
      "</style>"
    ]
  },
  "libraries": {
    "shadcn/ui": "Dialog (AlertDialog for confirmations)",
    "MUI": "Dialog (Modal is the low-level base)",
    "Chakra UI": "Dialog (v3) / Modal (v2)",
    "Mantine": "Modal",
    "Radix UI": "Dialog"
  },
  "a11yNotes": [
    "Trap focus while it is open",
    "Close on Esc",
    "Return focus to the trigger on close",
    "Give it an accessible name (aria-labelledby)"
  ],
  "tags": [
